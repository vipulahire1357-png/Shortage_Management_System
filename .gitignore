# ============================================================
# ABB Shortage Management System
# Keep source code, project configuration, dependency manifests,
# and documentation in Git. Ignore local/runtime/generated data.
# ============================================================

# Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Local environment variables and credentials
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# IDE and operating-system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Node.js dependencies and Vite build/cache output
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Logs and temporary files
logs/*
!logs/.gitkeep
!logs/README.md
*.log
*.tmp
*.temp
*.bak
*.backup
*.backup_*
*.old

# SQLite databases and journal / write-ahead-log files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Runtime staging and processed data; retain documentation/placeholders
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/*.db
data/**/*.db

# Project-specific operational report files
# Project directories can exist in Git, but local SAP workbooks/reports
# should not be newly added to source control.
projects/**/*.xls
projects/**/*.xlsx
projects/**/*.xlsm
projects/**/*.xlsb
projects/**/*.htm
projects/**/*.html
projects/**/*.csv
projects/**/*.txt
projects/**/*.tsv
projects/**/*.pdf

# Shared/global operational SAP report files
global/**/*.xls
global/**/*.xlsx
global/**/*.xlsm
global/**/*.xlsb
global/**/*.htm
global/**/*.html
global/**/*.csv
global/**/*.txt
global/**/*.tsv
global/**/*.pdf

# Generated Material Shortage Register Excel files
# Ignore workbook files only; allow directories, placeholders, and documentation.
Material Shortage Registers/*.xls
Material Shortage Registers/*.xlsx
Material Shortage Registers/*.xlsm
Material Shortage Registers/*.xlsb
Material Shortage Registers/*.XLS
Material Shortage Registers/*.XLSX
Material Shortage Registers/*.XLSM
Material Shortage Registers/*.XLSB
Material Shortage Registers/**/*.xls
Material Shortage Registers/**/*.xlsx
Material Shortage Registers/**/*.xlsm
Material Shortage Registers/**/*.xlsb
Material Shortage Registers/**/*.XLS
Material Shortage Registers/**/*.XLSX
Material Shortage Registers/**/*.XLSM
Material Shortage Registers/**/*.XLSB

# Generated Vendor Registers and vendor-facing Excel files
# Ignore workbook files only; preserve vendor and workflow folder structure.
Vendor Registers/*.xls
Vendor Registers/*.xlsx
Vendor Registers/*.xlsm
Vendor Registers/*.xlsb
Vendor Registers/*.XLS
Vendor Registers/*.XLSX
Vendor Registers/*.XLSM
Vendor Registers/*.XLSB
Vendor Registers/**/*.xls
Vendor Registers/**/*.xlsx
Vendor Registers/**/*.xlsm
Vendor Registers/**/*.xlsb
Vendor Registers/**/*.XLS
Vendor Registers/**/*.XLSX
Vendor Registers/**/*.XLSM
Vendor Registers/**/*.XLSB

# Vendor Date Registers (incoming vendor response workbooks)
Vendor Date Registers/*.xls
Vendor Date Registers/*.xlsx
Vendor Date Registers/*.xlsm
Vendor Date Registers/*.xlsb
Vendor Date Registers/*.XLS
Vendor Date Registers/*.XLSX
Vendor Date Registers/*.XLSM
Vendor Date Registers/*.XLSB
Vendor Date Registers/**/*.xls
Vendor Date Registers/**/*.xlsx
Vendor Date Registers/**/*.xlsm
Vendor Date Registers/**/*.xlsb
Vendor Date Registers/**/*.XLS
Vendor Date Registers/**/*.XLSX
Vendor Date Registers/**/*.XLSM
Vendor Date Registers/**/*.XLSB

# Microsoft Excel temporary/lock files
~$*.xls*

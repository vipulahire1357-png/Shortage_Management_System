# ============================================================
# ABB Shortage Management System — .gitignore
# Ignore local environments, caches, operational SAP data,
# generated databases, and generated register workbooks.
# Keep source code, dependency manifests, docs, and folder markers.
# ============================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Local environment/secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# IDEs and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Frontend / Node.js build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local logs and temporary files
logs/*
!logs/.gitkeep
!logs/README.md
*.log
*.tmp
*.temp

# SQLite databases and sidecar files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Staging and processed data — preserve explanatory files/markers
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/*.db
data/**/*.db

# Project-specific SAP source reports.
# These are operational inputs and should stay local, not in source control.
projects/**/*.xls
projects/**/*.xlsx
projects/**/*.xlsm
projects/**/*.xlsb
projects/**/*.htm
projects/**/*.html
projects/**/*.csv
projects/**/*.txt
projects/**/*.tsv
projects/**/*.pdf

# Shared/global SAP source reports
global/**/*.xls
global/**/*.xlsx
global/**/*.xlsm
global/**/*.xlsb
global/**/*.htm
global/**/*.html
global/**/*.csv
global/**/*.txt
global/**/*.tsv
global/**/*.pdf

# Generated Material Shortage Register exports
# Keep the directory and its generated workbooks out of Git.
Material Shortage Registers/*
!Material Shortage Registers/.gitkeep
!Material Shortage Registers/README.md

# Generated Vendor Registers and vendor-facing Excel files
Vendor Registers/*
!Vendor Registers/.gitkeep
!Vendor Registers/README.md

# Excel/Office temporary lock files
~$*.xls*
~$*.xlsx
~$*.xlsm
~$*.xlsb

# Optional local packaging/build outputs
build/
dist/
release/
*.spec
